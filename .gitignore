# ==========================================
# Unity Standard .gitignore
# ==========================================

# Unity generated directories (tymczasowe i cache)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/
ExportedObj/

# Unity Asset Server cache
AssetServerCache/

# Auto-generated project files (Visual Studio, Rider, VSCode)
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.pdb.meta
*.pdb.*
*.mdb
*.mdb.meta
*.opendb
*.VC.db

# Unity profiler & crash dumps
sysinfo.txt
crash.dmp

# Unity generated meta files for deleted assets
*.pidb.meta

# Visual Studio Code / Visual Studio cache
.vs/
.vscode/
.idea/
*.workspace

# Gradle cache (Android builds)
.gradle/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Antigravity & Agent temporary files
.agents/
.gemini/
